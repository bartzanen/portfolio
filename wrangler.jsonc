{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-14",

  // No `main`: this is an assets-only Worker. Cloudflare serves `out/` straight
  // from the asset layer, so no Worker code runs and no invocations are billed.
  // Adding a `main` entrypoint later is what unlocks dynamic routing.
  "assets": {
    "directory": "./out",

    // `next build` with `output: "export"` emits `<route>/index.html`, so
    // /about redirects to /about/ rather than 404ing.
    "html_handling": "auto-trailing-slash",

    // Serve the exported out/404.html with a real 404 status. Deliberately not
    // "single-page-application", which would answer every unknown URL with
    // index.html and a 200 — bad for SEO on a statically exported site.
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": true },

  // bartzanen.com is a zone on this Cloudflare account, so wrangler provisions
  // the hostname and its proxied apex record on deploy. Released from the old
  // Pages project first — a hostname cannot be attached to both at once.
  //
  // Apex only: www.bartzanen.com has no record and seo.url is the bare apex.
  "routes": [
    { "pattern": "bartzanen.com", "custom_domain": true }
  ]
}
