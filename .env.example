# Copy to .env.local for local development, or set it wherever the deployed
# build runs (Workers Builds settings, or CI secrets) — these are inlined at
# build time, not read by the Worker at runtime. Every variable here is
# optional — the site builds and runs without any of them.

# Cloudflare Web Analytics beacon token. When unset, the beacon script is not
# rendered at all, so local and preview builds stay untracked.
NEXT_PUBLIC_CF_BEACON_TOKEN=
